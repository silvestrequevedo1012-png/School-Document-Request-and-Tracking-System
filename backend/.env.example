# SQLite is the local default. Set DATABASE_URL to a Neon URL in production.
DATABASE_URL=sqlite:///./school_documents.db
JWT_SECRET_KEY=change-this-before-deploying
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
GOOGLE_ALLOWED_DOMAIN=
GOOGLE_ALLOW_PERSONAL_GMAIL=true
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USERNAME=
BREVO_SMTP_PASSWORD=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=School Document Request System
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
